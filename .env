# Default values, loaded in every mode (so `pnpm dev` is safe by default: it talks to a LOCAL backend).
# Production API lives in .env.production / .env.beta, which take priority in their modes.
# VITE_* variables are inlined into the public bundle: never put secrets here.
# To use another backend in dev, override in a git-ignored .env.local
VITE_API_BASE_URL=http://localhost:8001/v2
