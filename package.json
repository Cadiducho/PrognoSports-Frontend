  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/typography": "0.5.20",
    "@types/leaflet": "1.9.22",
    "@vitejs/plugin-vue": "6.0.9",
    "autoprefixer": "10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
