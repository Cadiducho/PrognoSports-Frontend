    "leaflet": "1.9.4",
    "marked": "18.1.0",
    "mitt": "3.0.1",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-advanced-cropper": "2.8.9",
    "vue-router": "5.3.1",
    "vue-sonner": "2.0.9",
    "vue3-apexcharts": "1.11.1",
    "vuedraggable": "4.1.0"
